function MidTreeBackChange(1Days, 2Days, 3Days, 4Days, 1Mids, 2Mids, 3Mids, 4Mids, 1Nights, 2Nights, 3Nights, 4Nights)
{
	BGDayTimeSet(1, 2, 0, 3,spr_ForestMidDay1)
	BGDayTimeSet(1, 2, 4, 5,spr_ForestMidE1)
	BGDayTimeSet(1, 2, 6, 7,spr_ForestMidNight1)
	
	BGDayTimeSet(1, 2, 0, 3,spr_ForestMidDay2)
	BGDayTimeSet(1, 2, 4, 5,spr_ForestMidE2)
	BGDayTimeSet(1, 2, 6, 7,spr_ForestMidNight2)
	
	BGDayTimeSet(1, 2, 0, 3,spr_ForestMidDay2)
	BGDayTimeSet(1, 2, 4, 5,spr_ForestMidE2)
	BGDayTimeSet(1, 2, 6, 7,spr_ForestMidNight2)
	
	BGDayTimeSet(1, 2, 0, 3,spr_ForestMidDay3)
	BGDayTimeSet(1, 2, 4, 5,spr_ForestMidE3)
	BGDayTimeSet(1, 2, 6, 7,spr_ForestMidNight3)
	
}